# Copy to .env (git-ignored) and fill in locally. Placeholders only.
TV_HOST=192.0.2.10            # your TV's LAN address (example range, not real)
ADB_CONNECT_PORT=5555         # discovered at pairing time; wireless debugging ports vary
PHONECAM_PUBLIC_PORT=8765
PHONECAM_ADMIN_PORT=8766
WEATHER_CITY_1=Example City
WEATHER_UNITS=celsius
# The assistant key is NOT read from .env: put it in private/assistant.secrets.json as
# {"google_api_key": "<your Google AI Studio key>"} (git-ignored; copied into the APK at build time).
